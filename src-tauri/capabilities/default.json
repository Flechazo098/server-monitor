{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "monitor-backend",
          "sidecar": true,
          "args": [
            { "args": ["--token", "true"] },
            { "args": ["--config", "true"] }
          ]
        }
      ]
    }
  ]
}
