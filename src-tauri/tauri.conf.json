{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "server-monitor",
  "version": "0.1.0",
  "identifier": "cc.sighs.server-monitor",
  "build": {
    "beforeDevCommand": "npm run dev --prefix F:/code/server/server-monitor/frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix F:/code/server/server-monitor/frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Server Monitor",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/monitor-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
