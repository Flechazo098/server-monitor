{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "new"
  },
  "tasks": [
    {
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "haskell build",
      "type": "shell",
      "command": "cabal build exe:monitor-backend",
      "options": {
        "cwd": "backend"
      }
    },
    {
      "group": "build",
      "type": "shell",
      "label": "haskell clean & build",
      "command": "cabal clean && cabal build exe:monitor-backend",
      "options": {
        "cwd": "backend"
      }
    },
    {
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "shell",
      "label": "frontend build",
      "command": "npm run build",
      "options": {
        "cwd": "frontend"
      }
    },
    {
      "isBackground": true,
      "type": "shell",
      "label": "haskell watch",
      "command": "cabal build --file-watch",
      "options": {
        "cwd": "backend"
      }
    }
  ]
}
