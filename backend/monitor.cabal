cabal-version:      3.0
name:               monitor-backend
version:            0.1.0.0
synopsis:           Read-only server monitor backend (Servant + Warp)
license:            BSD-3-Clause
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:
      Monitor.Core.Types
      Monitor.Collector.SSH
      Monitor.Collector.Parse
      Monitor.Storage.SQLite
      Monitor.Runtime.Worker
      Monitor.Api.Server
  build-depends:
      base          >=4.18 && <5
    , aeson        >=2.0
    , async        >=2.2
    , bytestring   >=0.11
    , containers   >=0.6
    , directory    >=1.3
    , network      >=3.1
    , process      >=1.6
    , servant      >=0.20
    , servant-server >=0.20
    , sqlite-simple >=0.4
    , stm          >=2.5
    , tagged       >=0.8
    , text         >=2.0
    , time         >=1.12
    , transformers >=0.5
    , wai          >=3.2
    , wai-websockets >=3.0
    , warp         >=3.3
    , websockets   >=0.12
    , http-types   >=0.12
  default-language: Haskell2010
  ghc-options:      -O1

executable monitor-backend
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      base
    , monitor-backend
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , stm
    , text
    , time
    , transformers
    , wai
    , warp
    , websockets
  default-language: Haskell2010
  ghc-options:      -O1 -threaded -rtsopts

executable monitor-contract
  hs-source-dirs:   app
  main-is:          Contract.hs
  build-depends:
      base
    , monitor-backend
    , aeson
    , containers
    , directory
    , filepath
    , text
    , time
  default-language: Haskell2010
  ghc-options:      -O1

test-suite monitor-tests
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
      base
    , monitor-backend
    , containers
    , directory
    , filepath
    , text
    , time
  default-language: Haskell2010
  ghc-options:      -Wall
